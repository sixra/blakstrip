---
import { inspectMedia } from '@lib/media';
import { formatBytes, percentSaved, PRESETS } from '@lib/media/compress';
import samplePdf from '@lib/pdf/__fixtures__/text-secrets.pdf?bytes';
import { inspectStructure } from '@lib/pdf/inspect';
import type { Finding } from '@lib/types';
import compressed from '../assets/samples/sample-photo.compressed.json';
import samplePhoto from '../assets/samples/sample-photo.jpg?bytes';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { TOOLS, type ToolHref } from '../config/tools';
import Base from '../layouts/Base.astro';

// The cards show what the tools actually do, not a picture of what they do.
//
// Astro runs this in Node at build time, so the real engines audit real sample
// files and their findings are rendered as plain HTML. Nothing ships to the
// browser for it, and it cannot drift: change what an engine detects and this
// page changes with it, or the build fails trying.
//
// The samples arrive as inlined bytes rather than through `fs`. This frontmatter
// is bundled into `dist/.prerender`, where `import.meta.url` points at a chunk in
// the output directory and a relative path to the source tree resolves to
// nothing. That bundle is thrown away after the build, so none of it ships.

// The compressor is the one tool whose card cannot be produced here. Its encode
// path decodes through `createImageBitmap` and an `OffscreenCanvas`, neither of
// which exists in Node, so its numbers are measured by the real codecs in
// `tests/browser/hub-samples.test.ts` and read back from what that wrote.
const sizes = PRESETS.map(({ id, label }) => {
  const row = compressed.presets.find((entry) => entry.preset === id);
  if (!row) {
    throw new Error(
      `sample-photo.compressed.json has no "${id}" row. Regenerate it with ` +
        '`pnpm exec vitest run --project browser -u tests/browser/hub-samples.test.ts`.'
    );
  }
  return {
    // Green, not the severity palette the other cards use: a saving is a good
    // outcome, and amber here would read as a warning about the file you just
    // made smaller. These must stay whole literals for Tailwind to find them.
    dot: 'bg-positive',
    label,
    detail: `${formatBytes(row.bytes)} ${row.format.toUpperCase()} · ${percentSaved(compressed.source.bytes, row.bytes)}% smaller`,
  };
});

const pdfFindings = await inspectStructure(new Uint8Array(samplePdf()));
const photoFindings = inspectMedia(new Uint8Array(samplePhoto())).findings;

/**
 * What a tool's card shows underneath its pitch.
 *
 * The cards prove different things (two list what a tool found, one lists what
 * each preset did) but they say it in the same shape, so the difference lives
 * here rather than in the template.
 */
interface Card {
  meta: string;
  /** `note` is read out before the label where the dot means something. */
  rows: { dot: string; note?: string; label: string; detail: string }[];
  /** Findings past the rows shown, so the count in `meta` is not contradicted. */
  more: number;
}

/** What fits before a card turns into a report. */
const MAX_ROWS = 5;

const findingCard = (sample: string, findings: Finding[]): Card => ({
  meta: `${sample} · ${findings.length} found`,
  rows: findings.slice(0, MAX_ROWS).map((finding) => ({
    dot: finding.severity === 'high' ? 'bg-danger' : 'bg-warning',
    // The dot carries severity to the eye and nothing carried it otherwise. Same
    // wording FindingsList.svelte uses for the same data on the tool pages.
    note: finding.severity === 'high' ? 'High severity: ' : 'Medium severity: ',
    label: finding.title,
    detail: finding.detail,
  })),
  more: Math.max(0, findings.length - MAX_ROWS),
});

/**
 * Exhaustive over `ToolHref`, so adding a tool to the registry fails the build
 * here until it has a card.
 */
const cards: Record<ToolHref, Card> = {
  '/pdf-redact': findingCard('quarterly-report.pdf', pdfFindings),
  '/media-strip': findingCard('holiday.jpg', photoFindings),
  '/image-compress': {
    meta: `holiday.jpg · ${compressed.source.width} × ${compressed.source.height} · ${formatBytes(compressed.source.bytes)}`,
    // No `note`: the green dot here only says a saving is good news, which the
    // detail beside it already says in words, so it is decoration.
    rows: sizes,
    more: 0,
  },
};

const site = 'https://blakstrip.com';

// One WebSite entity that the tools hang off, rather than the single
// WebApplication all three pages used to share. Two genuinely different programs
// claiming one @id told search engines the photo tool *was* the PDF redactor.
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  name: 'blakstrip',
  url: site,
  description:
    'Private, in-browser tools that remove what a file is carrying. Nothing is uploaded, and you can check that for yourself.',
  publisher: {
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: 'blakstrip',
    url: site,
    logo: {
      '@type': 'ImageObject',
      url: `${site}/android-chrome-512x512.png`,
      width: 512,
      height: 512,
    },
  },
  hasPart: TOOLS.map((tool) => ({
    '@type': 'WebApplication',
    '@id': tool.entityId,
    name: tool.name,
    url: `${site}${tool.href}`,
  })),
  creator: { '@type': 'Organization', name: 'sixra.dev', url: 'https://sixra.dev' },
};
const jsonLd = JSON.stringify(siteSchema).replace(/</g, '\\u003c');

// Kept short enough to survive a search result, and quote-free: the head assertions
// in tests/e2e/seo.spec.ts match on content="..." and cannot survive one.
const description =
  'Redact a PDF for good, strip the location and camera data out of a photo, or compress an image. It happens in your browser, and nothing is uploaded.';
---

<Base title="Redact, Strip and Compress Files Online, Free and Private · blakstrip" {description}>
  <div class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col px-4">
    <header class="pt-10 pb-6">
      <Header />
    </header>

    {
      /* No bottom padding: the footer brings its own `mt-24`, and the two stacked
        left the page trailing off into 144px of nothing. */
    }
    <main id="main" class="flex flex-1 flex-col pt-12">
      <div class="max-w-3xl">
        {
          /* The jobs before the promise. The page used to open on the guarantee, so
            someone arriving from a search had to reach the cards to find out what
            the site was for. */
        }
        <p class="text-ink mb-4 text-lg font-semibold tracking-tight text-balance sm:text-xl">
          Redact PDFs. Strip photo metadata. Compress images.
        </p>
        {/* -ml-2 cancels the strip's padding so "Nothing" aligns with "your" below. */}
        <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">
          <span class="bg-redact text-surface -ml-2 px-2">Nothing</span> leaves<br />your device.
        </h1>
        {
          /* "Most", not "every". Some other tools do run client-side, and one
            counterexample would make an absolute claim false on the page whose whole
            argument is that you can check what it says. */
        }
        <p class="text-muted mt-6 max-w-2xl text-lg text-pretty">
          Most tools for this upload your file to a server and ask you to trust what happens next.
          blakstrip does the work in your browser. Open the network panel before you start, and
          watch it stay empty.
        </p>
        <p class="text-faint mt-6 font-mono text-xs tracking-[0.2em] uppercase">
          Fully private · free · works offline
        </p>
      </div>

      <section class="mt-16" aria-labelledby="tools">
        {
          /* Hidden, not deleted: the cards say what they are, but the heading still
            gives them a level to sit under, and names this region so it stops
            reading as a second "Tools" beside the header nav. */
        }
        <h2 id="tools" class="sr-only">The tools</h2>
        {
          /* One column, then three. Two columns would always leave one of three
            cards alone on a row, at every width where two columns applied. Revisit
            if the registry ever holds four. */
        }
        <div class="grid gap-5 lg:grid-cols-3">
          {
            /* The whole card is the link, and `aria-labelledby` names it after the
              heading alone. Without that the accessible name is the heading plus the
              pitch plus the meta line plus five rows of evidence, read out as one
              string. Narrowing the anchor to the heading and stretching it back over
              the card with a pseudo-element would name it just as well, but it puts an
              overlay between the reader and the evidence to buy back a hit area this
              already has. */
          }
          {
            TOOLS.map((tool) => (
              <a
                href={tool.href}
                aria-labelledby={`card-${tool.href.slice(1)}`}
                class="border-line bg-raised hover:border-line-strong focus-visible:border-redact focus-visible:ring-redact group flex flex-col rounded-2xl border p-6 transition-colors focus-visible:ring-2 focus-visible:outline-none"
              >
                <h3 id={`card-${tool.href.slice(1)}`} class="text-xl font-semibold tracking-tight">
                  {tool.name}
                  <span
                    class="ml-1 inline-block transition-transform group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </h3>
                <p class="text-muted mt-2 text-sm">{tool.pitch}</p>

                <div class="mt-5">
                  <p class="text-faint font-mono text-xs">{cards[tool.href].meta}</p>
                  {/* Label and value share a line only while the card is full width,
                      which is below `lg`. In the three-column layout the card interior
                      is about 310px and the widest row wants nearer 390px, so the two
                      go back to stacking rather than clipping the value. The value is
                      the persuasive half: "51.50897, -0...." makes the point far less
                      well than the coordinate does. */}
                  <ul class="mt-3 space-y-2">
                    {cards[tool.href].rows.map((row) => (
                      <li class="flex flex-col text-sm sm:flex-row sm:items-baseline sm:gap-3 lg:flex-col lg:gap-0">
                        <span class="flex items-baseline gap-3">
                          <span
                            class:list={['h-1.5 w-1.5 shrink-0 rounded-full', row.dot]}
                            aria-hidden="true"
                          />
                          <span class="text-ink font-medium">
                            {row.note && <span class="sr-only">{row.note}</span>}
                            {row.label}
                          </span>
                        </span>
                        {/* Indented to line up under the label: the dot's own width
                            plus the gap after it. Written as the sum rather than the
                            total so it stays correct if either changes; a hardcoded
                            0.875rem was 4px short. */}
                        {/* Mono, because every one of these is a value read out of the
                            user's file, which is what the meta line above already uses
                            the face for. A monospaced face makes `tabular-nums` a
                            no-op, so it is gone with the truncation. */}
                        <span class="text-muted pl-[calc(0.375rem+0.75rem)] font-mono text-xs sm:ml-auto sm:pl-0 lg:ml-0 lg:pl-[calc(0.375rem+0.75rem)]">
                          {row.detail}
                        </span>
                      </li>
                    ))}
                  </ul>
                  {/* Outside the list, so a screen reader is not told there are six
                      items when the tool found eight and the card is showing five. */}
                  {cards[tool.href].more > 0 && (
                    <p class="text-faint mt-2 pl-[calc(0.375rem+0.75rem)] text-xs">
                      and {cards[tool.href].more} more
                    </p>
                  )}
                </div>
              </a>
            ))
          }
        </div>
        <p class="text-faint mt-4 text-sm text-pretty">
          Those are real results. The findings come from these tools reading sample files while this
          page was built, and the sizes from the same encoders the compressor ships, run in a
          browser and checked in with the tests. Not a screenshot.
        </p>
      </section>

      <section class="mt-24 max-w-3xl" aria-labelledby="verify">
        <h2 id="verify" class="text-2xl font-bold tracking-tight sm:text-3xl">
          <span class="bg-redact text-surface px-2">Verify it yourself</span>
        </h2>
        {
          /* The hero already tells you to watch the network panel, so this says the
            part the hero cannot: why it stays empty, and what else to try. */
        }
        <p class="text-muted mt-5">
          The panel stays empty because the page is served under a Content-Security-Policy that
          forbids the request outright, so it is not a promise the code has to keep. Then turn off
          your wifi and put a file through again.
        </p>
        <p class="text-muted mt-4">
          Every tool also re-reads the file it just produced and reports what is still in it,
          including anything it could not remove. A tool that says "done" and expects to be believed
          is worth less than one that shows its work.
        </p>
      </section>
    </main>

    <Footer />
  </div>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Base>
