---
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';

const features = [
  {
    title: 'Removed, not covered',
    body: "The parts you black out are erased from the page for good, not just hidden under a rectangle. There's nothing left to copy or recover.",
  },
  {
    title: 'Stays on your device',
    body: 'Your PDF is redacted right in your browser and never sent anywhere. You can check for yourself that nothing leaves your device, and it works offline too, with no account and no tracking.',
  },
  {
    title: "Finds what's hidden",
    body: "Before you start, blakstrip points out the hidden things in your file, like the author's name, comments, and attachments, and clears them out too.",
  },
  {
    title: 'Proof, not promises',
    body: "When you're done, blakstrip checks the finished file and shows you anything that could still be read, so you download knowing it's clean.",
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'blakstrip',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any modern web browser',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Free, private PDF redaction in your browser. blakstrip removes text and metadata for good instead of hiding it behind a black box. Nothing is uploaded.',
  url: 'https://blakstrip.com',
  publisher: {
    '@type': 'Organization',
    name: 'blakstrip',
    url: 'https://blakstrip.com',
    logo: 'https://blakstrip.com/apple-touch-icon.png',
  },
  creator: {
    '@type': 'Organization',
    name: 'sixra.dev',
    url: 'https://sixra.dev',
  },
};
// Escape `<` so document data can never break out of the <script> element.
const jsonLd = JSON.stringify(appSchema).replace(/</g, '\\u003c');
---

<Base
  title="Redact PDFs Privately, Right in Your Browser · blakstrip"
  description="Free, private PDF redaction in your browser. blakstrip removes text and metadata for good instead of hiding it behind a black box. Nothing is uploaded."
>
  <div class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col px-4">
    <header class="pt-10 pb-6">
      <Header />
    </header>

    <main id="main" class="flex flex-1 flex-col justify-center py-16">
      <div class="max-w-3xl">
        <p class="mb-4 font-mono text-xs tracking-widest text-neutral-600 uppercase">
          Fully private · free · works offline
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-6xl">
          Redact a PDF.<br />Leave <span class="bg-black px-2 text-white">nothing</span> behind.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-neutral-600">
          Remove sensitive text and hidden details from any PDF, permanently. blakstrip runs
          entirely on your device, so your file is never uploaded, shared, or seen by anyone.
          <strong class="mt-3 inline-block bg-black px-2 py-1 font-semibold text-white"
            >No upload. No account. No tracking.</strong
          >
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href="/pdf-redact"
            class="rounded-lg bg-neutral-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-700"
            >Redact a PDF</a
          >
        </div>
      </div>

      <section id="how" class="mt-24 scroll-mt-16">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">How it works</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            features.map((f) => (
              <article class="rounded-2xl border border-neutral-200 bg-white p-6">
                <h3 class="text-base font-semibold text-neutral-900">{f.title}</h3>
                <p class="mt-2 text-sm text-neutral-600">{f.body}</p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer
      class="flex flex-col gap-2 border-t border-neutral-200 py-6 text-xs text-neutral-600 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>No accounts, no uploads, no tracking. Turn off your wifi and it still works.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a
          href="https://github.com/sixra/blakstrip"
          class="inline-flex items-center gap-1.5 text-neutral-600 underline-offset-4 transition hover:text-neutral-900 hover:underline"
        >
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            fill="currentColor"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          Source on GitHub
        </a>
        <p>
          Built by <a
            href="https://sixra.dev"
            class="text-[#c73a1a] underline underline-offset-4 transition hover:opacity-80"
            >sixra.dev</a
          >
        </p>
      </div>
    </footer>
  </div>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Base>
