---
import { inspectMedia } from '@lib/media';
import samplePdf from '@lib/pdf/__fixtures__/text-secrets.pdf?bytes';
import { inspectStructure } from '@lib/pdf/inspect';
import type { Finding } from '@lib/types';
import samplePhoto from '../assets/samples/sample-photo.jpg?bytes';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { TOOLS, type ToolHref } from '../config/tools';
import Base from '../layouts/Base.astro';

// The cards show what the tools actually find, not a picture of what they find.
//
// Astro runs this in Node at build time, so the real engines audit real sample
// files and their findings are rendered as plain HTML. Nothing ships to the
// browser for it, and it cannot drift: change what an engine detects and this
// page changes with it, or the build fails trying.
//
// The samples arrive as inlined bytes rather than through `fs`. This frontmatter
// is bundled into `dist/.prerender`, where `import.meta.url` points at a chunk in
// the output directory and a relative path to the source tree resolves to
// nothing. That bundle is thrown away after the build, so none of it ships.
const findings: Record<ToolHref, Finding[]> = {
  '/pdf-redact': await inspectStructure(new Uint8Array(samplePdf())),
  '/media-strip': inspectMedia(new Uint8Array(samplePhoto())).findings,
};

const sampleName: Record<ToolHref, string> = {
  '/pdf-redact': 'quarterly-report.pdf',
  '/media-strip': 'holiday.jpg',
};

const site = 'https://blakstrip.com';

// One WebSite entity that the tools hang off, rather than the single
// WebApplication all three pages used to share. Two genuinely different programs
// claiming one @id told search engines the photo tool *was* the PDF redactor.
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  name: 'blakstrip',
  url: site,
  description:
    'Private, in-browser tools that remove what a file is carrying. Nothing is uploaded, and you can check that for yourself.',
  publisher: {
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: 'blakstrip',
    url: site,
    logo: {
      '@type': 'ImageObject',
      url: `${site}/android-chrome-512x512.png`,
      width: 512,
      height: 512,
    },
  },
  hasPart: TOOLS.map((tool) => ({
    '@type': 'WebApplication',
    '@id': tool.entityId,
    name: tool.name,
    url: `${site}${tool.href}`,
  })),
  creator: { '@type': 'Organization', name: 'sixra.dev', url: 'https://sixra.dev' },
};
const jsonLd = JSON.stringify(siteSchema).replace(/</g, '\\u003c');

const description =
  'Private, in-browser tools that remove what a file is carrying. Redact a PDF for good, or strip the location and camera data out of a photo. Nothing is uploaded.';
---

<Base title="blakstrip · private tools that remove what files carry" {description}>
  <div class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col px-4">
    <header class="pt-10 pb-6">
      <Header />
    </header>

    <main id="main" class="flex flex-1 flex-col py-12">
      <div class="max-w-3xl">
        <p class="text-faint mb-5 font-mono text-xs tracking-[0.2em] uppercase">
          Fully private · free · works offline
        </p>
        <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">
          Nothing leaves<br />your <span class="bg-redact text-surface px-2">device</span>.
        </h1>
        <p class="text-muted mt-6 max-w-2xl text-lg">
          Files carry more than you put in them. blakstrip finds it, removes it, and then re-reads
          the finished file to show you it is gone. All of it happens on your machine.
        </p>
      </div>

      <section class="mt-16" aria-label="Tools">
        <div class="grid gap-5 lg:grid-cols-2">
          {
            TOOLS.map((tool) => (
              <a
                href={tool.href}
                class="border-line bg-raised hover:border-line-strong group flex flex-col rounded-2xl border p-6 no-underline transition-colors"
              >
                <h2 class="text-2xl font-bold tracking-tight">{tool.name}</h2>
                <p class="text-muted mt-2 text-sm">{tool.pitch}</p>

                <div class="mt-5 flex-1">
                  <p class="text-faint font-mono text-xs">
                    {sampleName[tool.href]} · {findings[tool.href].length} found
                  </p>
                  {/* Each finding stacks on a phone and sits on one row from `sm` up.
                      Sharing a row at 390px squeezed the value column until it
                      truncated, and the value is the persuasive half: "51.50897,
                      -0...." makes the point far less well than the coordinate does.
                      Only the wide layout truncates, where there is room not to. */}
                  <ul class="mt-3 space-y-2">
                    {findings[tool.href].slice(0, 5).map((finding) => (
                      <li class="flex flex-col text-sm sm:flex-row sm:items-baseline sm:gap-3">
                        <span class="flex items-baseline gap-3">
                          <span
                            class:list={[
                              'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full',
                              finding.severity === 'high' ? 'bg-danger' : 'bg-warning',
                            ]}
                            aria-hidden="true"
                          />
                          <span class="text-ink font-medium">{finding.title}</span>
                        </span>
                        {/* Indented to line up under the title: the dot's own width
                            plus the gap after it. Written as the sum rather than the
                            total so it stays correct if either changes; a hardcoded
                            0.875rem was 4px short. */}
                        <span class="text-faint pl-[calc(0.375rem+0.75rem)] text-xs sm:ml-auto sm:truncate sm:pl-0">
                          {finding.detail}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>

                <p class="text-ink mt-6 text-sm font-semibold">
                  {tool.name}
                  <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">
                    →
                  </span>
                </p>
              </a>
            ))
          }
        </div>
        <p class="text-faint mt-4 text-xs">
          Those are real findings, produced by these tools against sample files when this page was
          built. Not a screenshot.
        </p>
      </section>

      <section class="mt-24 max-w-3xl" aria-labelledby="verify">
        <h2 id="verify" class="text-2xl font-bold tracking-tight sm:text-3xl">
          <span class="bg-redact text-surface px-2">Verify it yourself</span>
        </h2>
        <p class="text-muted mt-5">
          Every promise here is one you can check without trusting us. Open your browser's developer
          tools, watch the network panel, and use either tool on a real file. Nothing is sent,
          because the page is served under a policy that forbids it outright. Turn off your wifi and
          it still works.
        </p>
        <p class="text-muted mt-4">
          Both tools also re-read the file they just produced and report what is still in it,
          including anything they could not remove. A tool that says "done" and expects to be
          believed is worth less than one that shows its work.
        </p>
      </section>
    </main>

    <Footer />
  </div>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Base>
