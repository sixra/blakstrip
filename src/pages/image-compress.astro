---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ImageCompressor from '../components/ImageCompressor.svelte';
import { toolFor, toolSchema } from '../config/tools';
import Base from '../layouts/Base.astro';

// Resolved from this page's own route, so reordering TOOLS cannot quietly
// swap this page's metadata for another tool's.
const tool = toolFor(Astro.url.pathname);
const jsonLd = JSON.stringify(toolSchema(tool)).replace(/</g, '\\u003c');

const features = [
  {
    title: 'Three presets, or your own numbers',
    body: 'Smallest, Balanced or Best quality to start. Then set the quality, the PNG effort or a cap on the longest side yourself, and pick the format you want out: JPEG, PNG, WebP or AVIF.',
  },
  {
    title: 'Judge it at full size',
    body: 'Compression artefacts are invisible in a thumbnail, which is exactly where most tools show you the result. Here both versions are full size and you can pan around them, so you can look at the places that actually go wrong.',
  },
  {
    title: 'The metadata goes too, and that is checked',
    body: 'Compressing decodes the picture to raw pixels and encodes those, so there is nowhere for GPS, camera serials or hidden thumbnails to survive. blakstrip then re-reads its own output and tells you what it found, rather than asking you to take that on trust.',
  },
  {
    title: 'It works with the network off',
    body: 'The encoders are WebAssembly, shipped inside the page rather than fetched when you use them. Turn off your wifi and compress a photo. AVIF is the one exception: it is large enough to be loaded on demand, so it needs one online use first.',
  },
];
---

<Base title={tool.title} description={tool.description}>
  <div class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col px-4">
    <header class="pt-10 pb-6">
      <Header />
    </header>

    <main id="main" class="flex-1 py-6">
      <div class="mb-8 max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Make it smaller<br />without <span class="bg-redact text-surface px-2">sending it</span>.
        </h1>
        <p class="text-muted mt-5 text-lg">
          Re-encode a picture on your own machine, compare it against the original at full size, and
          keep it only if it still looks right.
        </p>
      </div>

      <ImageCompressor client:only="svelte" />

      <section class="mt-24" aria-labelledby="how">
        <h2 id="how" class="text-2xl font-bold tracking-tight sm:text-3xl">How this works</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {
            features.map((feature) => (
              <article class="border-line bg-raised rounded-2xl border p-6">
                <h3 class="text-base font-semibold">{feature.title}</h3>
                <p class="text-muted mt-2 text-sm">{feature.body}</p>
              </article>
            ))
          }
        </div>
        <p class="text-muted mt-6 text-sm">
          Want the metadata gone without touching the picture? <a href="/media-strip"
            >Remove image metadata</a
          > rewrites the container and leaves every pixel exactly as it was.
        </p>
      </section>
    </main>

    <Footer />
  </div>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Base>
