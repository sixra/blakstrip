---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MediaStripper from '../components/MediaStripper.svelte';
import { TOOLS, toolSchema } from '../config/tools';
import Base from '../layouts/Base.astro';

const tool = TOOLS[1];
const jsonLd = JSON.stringify(toolSchema(tool)).replace(/</g, '\\u003c');

// This page had no copy at all: it dropped you straight onto a drop zone with
// nothing explaining what it would do or why the lossless part matters.
const features = [
  {
    title: 'Your location, in the file',
    body: 'A photo from a phone usually records exactly where it was taken, to a few metres, along with the camera, its serial number, and the second you pressed the shutter. None of that is visible when you look at the picture.',
  },
  {
    title: 'The picture is untouched',
    body: 'Removing metadata rewrites the container around your image, not the image itself. The pixels come out byte for byte identical, so nothing is re-compressed and no quality is lost.',
  },
  {
    title: 'Smaller too, if you want',
    body: 'Once the file is clean you can optionally re-encode it: pick a preset or set quality and dimensions yourself, compare the result against the original at full size, and download whichever you prefer.',
  },
  {
    title: 'Checked, not claimed',
    body: 'After stripping, blakstrip re-reads the finished file from scratch and lists anything still in it. The clean verdict comes from reading the output, not from trusting the code that wrote it.',
  },
];
---

<Base title={tool.title} description={tool.description}>
  <div class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col px-4">
    <header class="pt-10 pb-6">
      <Header />
    </header>

    <main id="main" class="flex-1 py-6">
      <div class="mb-8 max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Your photo knows<br />where you <span class="bg-redact text-surface px-2">live</span>.
        </h1>
        <p class="text-muted mt-5 text-lg">
          See exactly what a picture is carrying about you, then take it out without touching the
          image itself. Your photo never leaves your device.
        </p>
      </div>

      <MediaStripper client:only="svelte" />

      <section class="mt-24" aria-labelledby="how">
        <h2 id="how" class="text-2xl font-bold tracking-tight sm:text-3xl">What this removes</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {
            features.map((feature) => (
              <article class="border-line bg-raised rounded-2xl border p-6">
                <h3 class="text-base font-semibold">{feature.title}</h3>
                <p class="text-muted mt-2 text-sm">{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Base>
