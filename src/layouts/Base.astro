---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Alt text for the social card. Defaults to describing the shared card, which
   * is the wordmark; override it if a page ever ships its own image.
   */
  imageAlt?: string;
}

// Both defaults are deliberately tool-neutral. They used to describe PDF
// redaction, which was right when that was the only tool and became a wrong
// claim on the hub and the photo tool the moment there were two. The description
// is only a fallback, since every page passes its own, but the alt text shipped
// on all of them.
const {
  title,
  description = 'Private, in-browser tools that remove what a file is carrying. Nothing is uploaded, and you can check that for yourself.',
  imageAlt = 'blakstrip, private in-browser file tools',
} = Astro.props;

// build.format: 'file' means /foo.html serves at /foo, so strip the suffix for a stable canonical.
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f4f4f4" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="blakstrip" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="bg-surface text-ink min-h-dvh font-sans antialiased">
    <a
      href="#main"
      class="focus:bg-redact focus:text-surface sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:px-3 focus:py-2"
      >Skip to content</a
    >
    <slot />
    <script>
      // Registered from a bundled module so Astro hashes it under the strict CSP.
      import { registerSW } from 'virtual:pwa-register';
      import { hasUnsavedWork } from '../lib/unsaved';
      import { showUpdateToast } from '../lib/update-toast';

      // `prompt`, not `autoUpdate`, and the difference matters here more than on
      // most sites. autoUpdate reloads the moment a new worker activates, and
      // nothing in this app is persisted: that reload discards the document
      // someone is redacting, on a file that exists nowhere else. So the update is
      // applied silently when the page is idle and offered when it is not.
      // Declared before assignment because the callbacks below close over it, which
      // a `const` initialised by the same call cannot do without circularity.
      let updateSW: (reloadPage?: boolean) => Promise<void>;
      updateSW = registerSW({
        immediate: true,
        onNeedRefresh() {
          if (!hasUnsavedWork()) {
            // Nothing to lose: behave exactly as autoUpdate did.
            void updateSW(true);
            return;
          }
          showUpdateToast(() => void updateSW(true));
        },
      });
    </script>
  </body>
</html>
