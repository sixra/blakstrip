---
// Shared site header: brand wordmark (links to the hub), the tool links, and the
// quiet install affordance. Used by every page so all of them stay identical.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { TOOLS } from '../config/tools';
import InstallButton from './InstallButton.svelte';

// build.format is 'file', so a page is served at /foo from /foo.html. The
// suffix is stripped before comparing, or the current tool never matches.
const here = Astro.url.pathname.replace(/\.html$/, '');
---

<div class="flex items-center gap-4">
  <a href="/" aria-label="blakstrip home">
    {
      /* Through astro:assets rather than public/, so the wordmark ships at the
        size it renders instead of the 791px source. The link's aria-label is the
        accessible name, so the alt text stays out of the way.

        PNG, not the default WebP: this is two-tone artwork with hard edges,
        downscaled about 8x, and lossy compression smears exactly that. Measured
        against an ideal downscale, WebP came out at 1.51 mean pixel error and
        looked visibly soft; PNG is 0.00. It costs about 10 KB more across the
        three variants. Lossless WebP would be half PNG's size at the same
        fidelity, but <Image> exposes format and quality and no lossless flag.

        `width` pins the fallback `src` to the rendered size. Without it Astro
        also emits a 791px variant, which was 17 KB nobody needed. `widths` then
        covers 1x, 2x and 3x.

        Left lazy on purpose. The header sits above the fold, but the LCP element
        on all three pages is the h1, not this (measured: text, ~90ms), so eager
        loading it would only compete with the thing that actually paints. */
    }
    <Image
      src={logo}
      alt=""
      format="png"
      width={96}
      widths={[96, 192, 288]}
      sizes="96px"
      class="h-12 w-auto"
    />
  </a>
  <nav aria-label="Tools" class="ml-auto">
    <ul class="flex items-center gap-1">
      {
        TOOLS.map((tool) => (
          <li>
            {/* The tool you are on is marked with a solid bar, which is the same
                device the rest of the site uses to mean "this is covered".
                aria-current carries it for a screen reader, so it is announced
                rather than offered as a link to the page already open. */}
            <a
              href={tool.href}
              aria-current={here === tool.href ? 'page' : undefined}
              class="text-muted hover:bg-raised hover:text-ink aria-[current=page]:bg-redact aria-[current=page]:text-surface rounded-lg px-3 py-1.5 text-sm no-underline transition-colors"
            >
              {tool.nav}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <InstallButton client:only="svelte" />
</div>
