{
  "name": "blakstrip",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Two in-browser privacy tools: a PDF redactor that erases content instead of covering it, and a photo metadata stripper. Nothing is uploaded.",
  "license": "MIT",
  "author": "sixra",
  "homepage": "https://blakstrip.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixra/blakstrip.git"
  },
  "bugs": {
    "url": "https://github.com/sixra/blakstrip/issues"
  },
  "keywords": [
    "pdf",
    "redaction",
    "redact",
    "privacy",
    "client-side",
    "in-browser",
    "metadata",
    "exif",
    "gps",
    "image-compression",
    "photo",
    "astro",
    "svelte",
    "pwa"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "find public -name .DS_Store -delete",
    "build": "astro check && astro build && node scripts/size-budget.mjs",
    "preview": "astro preview",
    "analyze": "node scripts/size-budget.mjs --no-check",
    "gen:icons": "node scripts/gen-icons.mjs",
    "astro": "astro",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "type-check": "astro check",
    "validate": "pnpm format:check && pnpm lint && pnpm type-check && pnpm build",
    "verify": "pnpm test:coverage && pnpm build && pnpm test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "svelte": "^5.57.0",
    "wasm-feature-detect": "^1.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
