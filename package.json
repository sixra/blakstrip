{
  "name": "blakstrip",
  "type": "module",
  "version": "1.0.0",
  "description": "A fully in-browser PDF redactor that removes content instead of covering it; nothing is uploaded.",
  "license": "MIT",
  "author": "sixra",
  "homepage": "https://blakstrip.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixra/blakstrip.git"
  },
  "bugs": {
    "url": "https://github.com/sixra/blakstrip/issues"
  },
  "keywords": [
    "pdf",
    "redaction",
    "redact",
    "privacy",
    "client-side",
    "in-browser",
    "metadata",
    "astro",
    "svelte",
    "pwa"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && build-stats",
    "preview": "astro preview",
    "analyze": "build-stats --no-check",
    "gen:icons": "node scripts/gen-icons.mjs",
    "astro": "astro",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "type-check": "astro check",
    "validate": "pnpm format:check && pnpm lint && pnpm type-check && pnpm build",
    "verify": "pnpm test:coverage && pnpm build && pnpm test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.62.0",
    "@sixra/devkit": "github:sixra/devkit#semver:^1.0.0",
    "@types/node": "^26.1.1",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.65.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
