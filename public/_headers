# Security response headers (Cloudflare Pages / Netlify read this file).
# These cannot be expressed in the <meta> CSP: frame-ancestors and X-Frame-Options
# are ignored when a policy is delivered via <meta>, so a clickjacking defense for a
# tool that handles sensitive documents has to be a real response header.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), display-capture=(), encrypted-media=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

# The <meta> CSP governs the page, but a worker loaded from a same-origin URL does
# not inherit it (only blob:/data: workers do). The pdf.js worker is where the
# user's document is actually parsed, so the no-egress guarantee has to be
# delivered to it as a response header or it does not apply where it matters most.
/_astro/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'none'

# The service worker needs same-origin fetches to fill its precache.
/sw.js
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'
