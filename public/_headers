# Cloudflare Pages headers: https://developers.cloudflare.com/pages/configuration/headers/
# Note that every matching rule contributes, and duplicate header names are joined
# with a comma, so the per-path rules below add to this block rather than replace it.
# These cannot be expressed in the <meta> CSP: frame-ancestors and X-Frame-Options
# are ignored when a policy is delivered via <meta>, so a clickjacking defense for a
# tool that handles sensitive documents has to be a real response header.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), display-capture=(), encrypted-media=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

# Build assets carry a content hash in the filename, so they can never change
# under a given URL: cache them for a year. This is where the ~1.3 MB pdf.js
# worker and the app chunks live, so it is most of the repeat-visit cost.
#
# The CSP here is additive, not a replacement. Cloudflare joins duplicate header
# values with a comma, and a comma-separated CSP is parsed as several independent
# policies, so these files end up with `frame-ancestors 'none'` from the rule
# below *and* `connect-src 'none'` from this one, each enforced on its own.
#
# The <meta> CSP governs the page, but a worker loaded from a same-origin URL does
# not inherit it (only blob:/data: workers do). The pdf.js worker is where the
# user's document is actually parsed, so the no-egress guarantee has to reach it
# as a response header or it does not apply where it matters most.
#
# Deliberately connect-src only. The pdf.js worker bundle uses Function(), spawns
# sub-workers and references WebAssembly; because the policies apply independently,
# a `default-src 'none'` here would block all of that no matter what the meta CSP
# allows, breaking PostScript function evaluation and image decoding. Those are
# capabilities, not egress. `astro preview` does not apply this file, so nothing in
# the test suite covers it: keep it minimal.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Security-Policy: connect-src 'none'

# The service worker fetches same-origin assets to fill its precache, and nothing
# else. It must always revalidate: its precache manifest names every hashed asset,
# so a stale sw.js pins an entire stale build, offline, indefinitely.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: connect-src 'self'

# Workbox runtime, content-hashed like the build assets.
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

# Unhashed names: cache, but let a replacement actually reach repeat visitors.
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=604800, must-revalidate
/*.xml
  Cache-Control: public, max-age=86400, must-revalidate
/*.txt
  Cache-Control: public, max-age=86400, must-revalidate

# Pages are served extensionless; these are the direct .html requests.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
